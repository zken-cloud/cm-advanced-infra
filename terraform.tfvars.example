# Copy to terraform.tfvars and fill in. Four values.
#
#   cp terraform.tfvars.example terraform.tfvars
#   export TF_VAR_github_token=ghp_xxxxxxxx      # NOT in this file
#
# The PAT is a CLASSIC token with exactly two scopes ticked:
#   repo      -- create the repo, push, set Actions variables, and let the find
#                pods and the reconciler clone it
#   workflow  -- without it the push carrying .github/workflows/ is REJECTED, and
#                the fan-out never fires
#
# NOT read:org, though `gh auth login` demands it: everything here passes GH_TOKEN
# in the environment instead, which skips gh's scope validation and makes the same
# calls. Reintroducing `gh auth login` widens this token by two scopes.
# Verify before applying:
#   curl -sI -H "Authorization: token $TF_VAR_github_token" \
#     https://api.github.com/user | grep -i x-oauth-scopes
#   terraform init && terraform apply

project_id   = "your-gcp-project"        # CodeMender must be enabled on it
github_owner = "your-github-username"    # your repo is created here

# Who may SSH through IAP. Project ownership does NOT include this.
iap_ssh_members = ["user:you@example.com"]

# --- optional -----------------------------------------------------------------
# region        = "us-central1"   # must stay: cm-fanout.yml hardcodes it
# lab_repo_name = "cm-lab"
#
# Already have a WIF pool called cm-lab-github? Bind to it instead of failing on
# ALREADY_EXISTS. Never delete a pool to get around that -- deletion is a 30-day
# soft delete and the name stays taken the whole time.
# create_wif_pool = false
